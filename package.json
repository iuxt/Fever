{
  "name": "fever-notes",
  "version": "0.1.0",
  "description": "Local-first Markdown notes with Git history",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:desktop": "node tests/electron-smoke.mjs",
    "test:desktop:tabs": "node tests/electron-tabs.mjs",
    "test:memory": "npm run build && node tests/memory-stress.mjs"
  },
  "keywords": [],
  "author": "Fever",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@uiw/react-codemirror": "^4.25.12",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.52.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "micromark": "^4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "private": true,
  "build": {
    "appId": "app.fever.notes",
    "productName": "Fever",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "icons",
        "filter": [
          "fever.png",
          "fever.ico"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icons/fever.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/fever.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Fever-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icons/png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
